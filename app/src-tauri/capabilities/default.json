{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The only permissions the window has: talk to Veil's own commands, listen for progress events, open the system file pickers, and open message links on the platforms Veil reads (and the pages where email providers hand out app passwords) in the browser. No shell, no file system, no HTTP.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://discord.com/channels/*" },
        { "url": "https://www.reddit.com/*" },
        { "url": "https://x.com/*" },
        { "url": "https://t.me/c/*" },
        { "url": "https://www.linkedin.com/*" },
        { "url": "https://mail.google.com/mail/*" },
        { "url": "https://myaccount.google.com/apppasswords" },
        { "url": "https://login.yahoo.com/account/security" },
        { "url": "https://account.apple.com" },
        { "url": "https://www.gmx.net" },
        { "url": "https://app.fastmail.com/settings/security/apps" }
      ]
    }
  ]
}
